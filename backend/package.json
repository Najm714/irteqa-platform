{
  "name": "irteqa-backend",
  "version": "1.0.0",
  "description": "Irteqa Platform Backend - Shared Core",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:prod": "NODE_ENV=production node scripts/seed.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "backup": "node scripts/backup.js backup",
    "backup:files": "node scripts/backup-files.js backup",
    "backup:all": "npm run backup && npm run backup:files",
    "restore": "node scripts/backup.js restore",
    "restore:files": "node scripts/backup-files.js restore",
    "backup:list": "node scripts/backup.js list",
    "backup:clean": "node scripts/backup.js clean"
  },
  "keywords": [
    "irteqa",
    "platform",
    "portals",
    "requests",
    "education"
  ],
  "author": "Najm714",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.529.0",
    "@aws-sdk/s3-request-presigner": "^3.529.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "form-data": "^4.0.6",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "peerjs": "^1.5.5",
    "recorder-core": "^1.3.26070800",
    "socket.io": "^4.7.4",
    "validator": "^13.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12"
  }
}
